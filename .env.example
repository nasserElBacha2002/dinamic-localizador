# Dinamic Attendance — variables de entorno para Docker Compose
#
# Copiá este archivo a `.env` en la raíz del proyecto y completá los valores.
# El `.env` raíz es la fuente de verdad para `docker compose` en el servidor.
# No alcanza con cargar estas variables solo en `backend/.env`.
#
# Para desarrollo local:
#   docker compose --env-file .env up -d --build
#
# Para producción:
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# `backend/.env` sirve para ejecutar Node fuera de Docker.
# `frontend/.env` sirve para Vite local (`npm run dev`).
# En producción Docker, las variables VITE_* se inyectan durante el build del frontend.

NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

BACKEND_INTERNAL_PORT=3000
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173

FRONTEND_URL=http://localhost:8084
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8084,http://127.0.0.1:8084,http://localhost:5173,http://localhost:5174

VITE_API_URL=http://localhost:3000/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Prefer server-side key for geocoding CLI / location_zones backfill (falls back to VITE_*).
GOOGLE_MAPS_API_KEY=

# Producción (deploy via GHCR): imagen pre-construida en GitHub Actions.
# Ejemplo: FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/frontend:develop-latest
# docker/compose + CI/deploy only (required by docker-compose.prod.yml).
FRONTEND_IMAGE=

DB_HOST=sqlserver
DB_PORT=1433
DB_PORT_EXTERNAL=14330
DB_NAME=dinamic_attendance
# Runtime identity (backend). Local Docker defaults to sa; production should use a
# dedicated login mapped to database role dinamic_app_runtime (see Phase 3–4 audit).
DB_USER=sa
# Contraseña SA de SQL Server para Docker Compose (sqlserver healthcheck / db-init).
# Also used as shared app password until runtime/migration identities are split.
DB_PASSWORD=
# Optional dedicated migration identity (migrations service / npm run migrate).
# Both unset → shared DB_USER/DB_PASSWORD. Both set → dedicated. Partial pair → error.
# To reuse the same secret deliberately, set DB_MIGRATION_PASSWORD explicitly (do not omit).
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Optional real-login privilege smoke tests (test-only).
# RUN_DB_PRIVILEGE_TESTS=true + credentials required to enable the suite.
DB_PRIVILEGE_TEST_USER=
DB_PRIVILEGE_TEST_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=
JWT_EXPIRES_IN=8h

# 2FA TOTP (required in production — backend fail-fast if missing).
# TWO_FACTOR_ENCRYPTION_KEY: exactly 32 bytes as base64 or 64 hex chars. Do not reuse JWT_SECRET.
# TWO_FACTOR_CHALLENGE_SECRET: min 16 chars, must differ from JWT_SECRET.
TWO_FACTOR_ISSUER=Dinamic Attendance
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_CHALLENGE_SECRET=
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
TWO_FACTOR_SETUP_TTL_MINUTES=10
# Rate limit in-memory (per process). Same window/max for login/2fa, confirm, disable, regenerate.
TWO_FACTOR_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
TWO_FACTOR_LOGIN_RATE_LIMIT_MAX=8

INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
# Timing floor for forgot-password (mitigates obvious enumeration; not constant-time)
PASSWORD_RESET_MIN_DURATION_MS=300
PASSWORD_RESET_DURATION_JITTER_MS=150
# In-memory rate limits apply per process (not shared across instances)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5
# EMAIL_TRANSPORT=smtp|console|disabled
# console only in development/test (never counts as delivered).
# production: use smtp (requires SMTP_*) or explicit disabled.
# EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=
TWILIO_VALIDATE_SIGNATURE=false
# Public HTTPS URL Twilio signs for delivery status (no trailing slash).
# Example: https://api.example.com/api/webhooks/twilio/whatsapp/status
TWILIO_STATUS_CALLBACK_URL=
TWILIO_ARRIVAL_REMINDER_CONTENT_SID=
TWILIO_EXIT_REMINDER_CONTENT_SID=
TWILIO_TEMPLATE_NO_CHECKIN_SID=
TWILIO_ATTENDANCE_CONFIRMATION_CONTENT_SID=
TWILIO_PAYROLL_RECEIPT_AVAILABLE_CONTENT_SID=
# Content template aviso_recibo: single body var {{1}} = MM/YY (e.g. 07/26). Do not include employee name.
TWILIO_EVENTUAL_OPERATION_ASSIGNED_CONTENT_SID=
# Content template EVENTUAL_OPERATION_ASSIGNED: {{1}} employeeFirstName, {{2}} service ref, {{3}} date DD/MM/YYYY (BOT_OPERATION_TIMEZONE), {{4}} time HH:mm.
ATTENDANCE_REMINDER_JOB_ENABLED=true
WHATSAPP_OBSERVABILITY_ENABLED=true
WHATSAPP_OBSERVABILITY_UI_ENABLED=true
WHATSAPP_TWILIO_STATUS_CALLBACK_ENABLED=true
# Required in production when WHATSAPP_OBSERVABILITY_ENABLED=true. Use a strong random secret (>=16 chars). Do not reuse JWT_SECRET.
WHATSAPP_OBSERVABILITY_PHONE_HASH_SECRET=
WHATSAPP_OBSERVABILITY_MESSAGE_RETENTION_DAYS=90
WHATSAPP_OBSERVABILITY_TEMPLATE_VARS_RETENTION_DAYS=90
WHATSAPP_OBSERVABILITY_FLOW_RETENTION_DAYS=90
WHATSAPP_OBSERVABILITY_CANDIDATE_RETENTION_DAYS=90
WHATSAPP_OBSERVABILITY_PROVIDER_EVENT_RETENTION_DAYS=90
WHATSAPP_OBSERVABILITY_CLEANUP_JOB_ENABLED=true
RECURRING_WORKDAY_HORIZON_DAYS=60
RECURRING_WORKDAY_MATERIALIZATION_JOB_ENABLED=true

BOT_SESSION_TTL_MINUTES=15
BOT_OPERATION_TIMEZONE=America/Argentina/Buenos_Aires
BOT_DEFAULT_RADIUS_METERS=150
BOT_GEOFENCE_REVIEW_MARGIN_METERS=30
BOT_ON_TIME_GRACE_MINUTES=15
BOT_CHECKOUT_EARLY_TOLERANCE_MINUTES=15
# Opcional: empresa por defecto del bot cuando hay varias activas
BOT_DEFAULT_COMPANY_ID=
BOT_DEFAULT_COMPANY_NAME=Dinamic Systems

# Google Cloud Storage — adjuntos de ausencias (bucket privado)
# Preferir ADC / Workload Identity en producción. No versionar JSON de service account.
# Docker: monta ./secrets → /app/secrets (ver secrets/README.md)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json
# Local (backend/): GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-service-account.json
# Optional ADC project hint used by GCS pilot scripts (not required when GCS_PROJECT_ID is set).
GCLOUD_PROJECT=
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_STORAGE_PREFIX=absence-attachments
GCS_SIGNED_URL_EXPIRATION_SECONDS=300
GCS_MAX_FILE_SIZE_BYTES=5242880
GCS_MAX_FILES_PER_REQUEST=5
GCS_MAX_TOTAL_SIZE_BYTES=15728640
GCS_UPLOAD_MODE=BACKEND_STREAM
GCS_REQUIRED=false
PLATFORM_SERVER_STATUS_CHECK_TIMEOUT_MS=3000
API_SERVICE_NAME=dinamic-attendance-api
ABSENCE_ATTACHMENT_CLEANUP_JOB_ENABLED=true
PAYROLL_RECEIPTS_STORAGE_PREFIX=payroll-receipts
PAYROLL_RECEIPTS_MAX_FILES_PER_BATCH=50
PAYROLL_RECEIPT_NOTIFICATION_WORKER_ENABLED=true
PAYROLL_RECEIPT_NOTIFICATION_WORKER_INTERVAL_MS=60000
PAYROLL_RECEIPT_NOTIFICATION_LEASE_MS=120000
PAYROLL_RECEIPT_NOTIFICATION_MAX_ATTEMPTS=5
PAYROLL_RECEIPT_NOTIFICATION_RETRY_BASE_MS=30000
PAYROLL_RECEIPT_MEDIA_URL_EXPIRATION_SECONDS=900
# Content template EVENTUAL_OPERATION_ASSIGNED: {{1}} employeeFirstName, {{2}} service ref, {{3}} date DD/MM/YYYY (BOT_OPERATION_TIMEZONE), {{4}} time HH:mm.
# Production: set TWILIO_EVENTUAL_OPERATION_ASSIGNED_CONTENT_SID, then OPERATION_ASSIGNMENT_NOTIFICATION_WORKER_ENABLED=true
# (fail-fast at startup if worker=true and SID empty). Local/dev default remains false.
OPERATION_ASSIGNMENT_NOTIFICATION_WORKER_ENABLED=false
OPERATION_ASSIGNMENT_NOTIFICATION_WORKER_INTERVAL_MS=60000
OPERATION_ASSIGNMENT_NOTIFICATION_LEASE_MS=120000
OPERATION_ASSIGNMENT_NOTIFICATION_MAX_ATTEMPTS=5
OPERATION_ASSIGNMENT_NOTIFICATION_RETRY_BASE_MS=30000
# Admin WhatsApp alerts (default off until recipients + Content SID configured)
TWILIO_ADMIN_OPERATIONAL_ALERT_CONTENT_SID=
TWILIO_ADMIN_REQUEST_ALERT_CONTENT_SID=
ADMIN_ALERT_WORKER_ENABLED=false
ADMIN_ALERT_WORKER_INTERVAL_MS=60000
ADMIN_ALERT_LEASE_MS=120000
ADMIN_ALERT_MAX_ATTEMPTS=5
ADMIN_ALERT_RETRY_BASE_MS=30000
COMPANY_DELETION_GRACE_PERIOD_DAYS=30
COMPANY_DELETION_JOB_ENABLED=true
COMPANY_DELETION_JOB_INTERVAL_MS=3600000
# ONE_TIME clock promotions (SCHEDULED/IN_PROGRESS → COMPLETED). Startup + interval. No lookback window.
OPERATION_LIFECYCLE_JOB_ENABLED=true
OPERATION_LIFECYCLE_JOB_INTERVAL_MS=60000
OPERATION_LIFECYCLE_JOB_BATCH_SIZE=100
OPERATION_LIFECYCLE_JOB_MAX_BATCHES_PER_TICK=20
COMPANY_DELETION_LEASE_MS=1800000
COMPANY_DELETION_MAX_ATTEMPTS=10
COMPANY_DELETION_RETRY_BASE_MS=60000
COMPANY_PROTECTED_IDS=
COMPANY_PROTECTED_NAMES=Dinamic Systems
ABSENCE_ATTACHMENT_PENDING_TTL_MINUTES=60
# Phase 5 operational integration is per-company (company_settings.absence_operational_integration_enabled).
# Enable with: npx tsx --import ./src/test-helpers/preload-test-env.ts src/scripts/enable-absence-operational-integration.ts --company=<uuid>

# --- Test / CI / scripts only (optional; leave empty for normal local runtime) ---
# Enable DB-backed integration suites: RUN_DB_INTEGRATION_TESTS=true npm test
RUN_DB_INTEGRATION_TESTS=
RUN_DB_PRIVILEGE_TESTS=
# Password for seed-integration-ci owner user (script-only).
OWNER_PASSWORD=
# Optional fixtures for absence-phase5 SQL concurrency integration test.
TEST_COMPANY_ID=
TEST_ABSENCE_REQUEST_ID=
