# HTTPS — arquitectura UNIFICADA legacy (website / + app catch-all en el mismo apex).
# Usar solo para rollback o entornos que aún no aplicaron separación app.*.
# Cutover objetivo: deploy/nginx.dinamicoperations.com.conf.template (apex solo website).
#
#   export WEBSITE_HOST_PORT=8085 FRONTEND_HOST_PORT=8084
#   envsubst '${WEBSITE_HOST_PORT} ${FRONTEND_HOST_PORT}' \
#     < deploy/nginx.dinamicoperations.com.legacy-unified.conf.template \
#     > /etc/nginx/sites-available/dinamicoperations.com

server {
    listen 443 ssl http2;
    server_name dinamicoperations.com;

    ssl_certificate /etc/letsencrypt/live/dinamicoperations.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dinamicoperations.com/privkey.pem;

    location /api/ {
        return 404;
    }

    location ^~ /marketing-assets/ {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /assets/ {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /favicon.svg {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_set_header Host $host;
    }

    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Referrer-Policy "no-referrer" always;
    }
}

server {
    listen 80;
    server_name dinamicoperations.com;
    return 301 https://dinamicoperations.com$request_uri;
}
