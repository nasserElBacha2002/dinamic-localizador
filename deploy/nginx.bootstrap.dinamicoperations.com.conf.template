# BOOTSTRAP (HTTP only) — instalar ANTES de Certbot.
# STEP 1–3 en docs/production-domain-cutover.md (Fase C bootstrap).
#
#   export WEBSITE_HOST_PORT=8085 FRONTEND_HOST_PORT=8084
#   envsubst '${WEBSITE_HOST_PORT} ${FRONTEND_HOST_PORT}' \
#     < deploy/nginx.bootstrap.dinamicoperations.com.conf.template \
#     > /etc/nginx/sites-available/dinamicoperations.com
#
# server_name: solo apex. Si configurás DNS www, añadí un bloque server :80
# separado con server_name www.dinamicoperations.com (mismo routing) o incluí
# www en server_name SOLO si el registro www existe.

server {
    listen 80;
    server_name dinamicoperations.com;

    location /api/ {
        return 404;
    }

    location ^~ /marketing-assets/ {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /assets/ {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /favicon.svg {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_set_header Host $host;
    }

    location = / {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Referrer-Policy "no-referrer" always;
    }
}
