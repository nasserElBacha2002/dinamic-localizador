# HTTPS FINAL — app.dinamicoperations.com — NO instalar sin certificados válidos.
# Bootstrap HTTP: deploy/nginx.bootstrap.app.dinamicoperations.com.conf.template
#
#   export FRONTEND_HOST_PORT=8084
#   envsubst '${FRONTEND_HOST_PORT}' \
#     < deploy/nginx.app.dinamicoperations.com.conf.template \
#     > /etc/nginx/sites-available/app.dinamicoperations.com

server {
    listen 443 ssl http2;
    server_name app.dinamicoperations.com;

    ssl_certificate /etc/letsencrypt/live/app.dinamicoperations.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.dinamicoperations.com/privkey.pem;

    location /api/ {
        return 404;
    }

    location ^~ /assets/ {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location = /sitemap.xml {
        return 404;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}

server {
    listen 80;
    server_name app.dinamicoperations.com;
    return 301 https://$host$request_uri;
}
