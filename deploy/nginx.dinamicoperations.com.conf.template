# HTTPS FINAL (STEP 6+) — apex SOLO website (+ redirects legacy selectivos a app).
# NO instalar hasta que app.dinamicoperations.com esté operativo (ver docs/production-domain-cutover.md).
# Bootstrap HTTP: deploy/nginx.bootstrap.dinamicoperations.com.conf.template
#
#   export WEBSITE_HOST_PORT=8085 APP_PUBLIC_ORIGIN=https://app.dinamicoperations.com
#   envsubst '${WEBSITE_HOST_PORT} ${APP_PUBLIC_ORIGIN}' \
#     < deploy/nginx.dinamicoperations.com.conf.template \
#     > /etc/nginx/sites-available/dinamicoperations.com
#
# Redirects legacy selectivos (lista en docs/production-domain-cutover.md — Fase 2C).
# Rollback unificado: deploy/nginx.dinamicoperations.com.legacy-unified.conf.template

server {
    listen 443 ssl http2;
    server_name dinamicoperations.com;

    ssl_certificate /etc/letsencrypt/live/dinamicoperations.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dinamicoperations.com/privkey.pem;

    location /api/ {
        return 404;
    }

    location ^~ /marketing-assets/ {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /favicon.svg {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_set_header Host $host;
    }

    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /login {
        return 301 ${APP_PUBLIC_ORIGIN}/login$is_args$args;
    }
    location = /login/2fa {
        return 301 ${APP_PUBLIC_ORIGIN}/login/2fa$is_args$args;
    }
    location = /forgot-password {
        return 301 ${APP_PUBLIC_ORIGIN}/forgot-password$is_args$args;
    }
    location = /reset-password {
        return 301 ${APP_PUBLIC_ORIGIN}/reset-password$is_args$args;
    }
    location = /invitations/accept {
        return 301 ${APP_PUBLIC_ORIGIN}/invitations/accept$is_args$args;
    }

    location ~ ^/(operations|employees|absences|settings|platform)(/|$) {
        return 301 ${APP_PUBLIC_ORIGIN}$request_uri;
    }

    location = / {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Referrer-Policy "no-referrer" always;
    }
}

# Opcional — solo si DNS www está configurado (certificado debe incluir -d www...):
# server {
#     listen 443 ssl http2;
#     server_name www.dinamicoperations.com;
#     ssl_certificate /etc/letsencrypt/live/dinamicoperations.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/dinamicoperations.com/privkey.pem;
#     return 301 https://dinamicoperations.com$request_uri;
# }

server {
    listen 80;
    server_name dinamicoperations.com;
    return 301 https://dinamicoperations.com$request_uri;
}
