# Variables para ejecutar el backend fuera de Docker (npm run dev en backend/).
# En producción con Docker Compose, usá el `.env` raíz del monorepo.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8084
APP_BASE_URL=http://localhost:3000
# Incluí el origen real del browser (localhost y 127.0.0.1 son distintos para CORS).
# `npm run dev` del frontend usa el puerto 8084.
CORS_ALLOWED_ORIGINS=http://localhost:8084,http://127.0.0.1:8084,http://localhost:5173,http://localhost:5174
TZ=America/Argentina/Buenos_Aires

DB_HOST=localhost
DB_PORT=14330
DB_NAME=dinamic_attendance
# Runtime identity. Prefer a login in role dinamic_app_runtime (not sa) in non-local envs.
DB_USER=sa
DB_PASSWORD=
# Optional dedicated migration identity for `npm run migrate`.
# Both unset → DB_USER/DB_PASSWORD. Both set → dedicated. Partial pair → config error.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Optional real-login privilege smoke tests (test-only).
DB_PRIVILEGE_TEST_USER=
DB_PRIVILEGE_TEST_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=
# Debe coincidir exactamente con la URL pública configurada en Twilio (sin slash final).
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_ARRIVAL_REMINDER_CONTENT_SID=
TWILIO_EXIT_REMINDER_CONTENT_SID=
TWILIO_ATTENDANCE_CONFIRMATION_CONTENT_SID=
TWILIO_TEMPLATE_NO_CHECKIN_SID=
TWILIO_PAYROLL_RECEIPT_AVAILABLE_CONTENT_SID=
# Content template variables: single body var {{1}} = MM/YY (e.g. 07/26). Do not include employee name.
TWILIO_EVENTUAL_OPERATION_ASSIGNED_CONTENT_SID=
# Content template EVENTUAL_OPERATION_ASSIGNED: {{1}} employeeFirstName, {{2}} service ref, {{3}} date DD/MM/YYYY (BOT_OPERATION_TIMEZONE), {{4}} time HH:mm.
# Public HTTPS URL for Twilio delivery status callbacks (e.g. https://api.example.com/api/webhooks/twilio/whatsapp/status)
TWILIO_STATUS_CALLBACK_URL=
ATTENDANCE_REMINDER_JOB_ENABLED=true
WHATSAPP_OBSERVABILITY_ENABLED=true
WHATSAPP_OBSERVABILITY_UI_ENABLED=true
WHATSAPP_TWILIO_STATUS_CALLBACK_ENABLED=true
# Dedicated stable secret for phone hashing/encryption (do not reuse JWT_SECRET)
WHATSAPP_OBSERVABILITY_PHONE_HASH_SECRET=
WHATSAPP_RETENTION_DAYS=30
WHATSAPP_RETENTION_DRY_RUN=true
WHATSAPP_RETENTION_BATCH_SIZE=500
WHATSAPP_RETENTION_MAX_BATCHES_PER_TABLE=100
WHATSAPP_RETENTION_CLEANUP_JOB_ENABLED=true
WHATSAPP_RETENTION_CLEANUP_INTERVAL_MS=21600000
RECURRING_WORKDAY_HORIZON_DAYS=60
RECURRING_WORKDAY_MATERIALIZATION_JOB_ENABLED=true
BOT_SESSION_TTL_MINUTES=15
# Fallbacks cuando no hay fila company_settings o valor explícito por empresa
BOT_OPERATION_TIMEZONE=America/Argentina/Buenos_Aires
BOT_DEFAULT_RADIUS_METERS=150
BOT_GEOFENCE_REVIEW_MARGIN_METERS=30
BOT_ON_TIME_GRACE_MINUTES=15
BOT_CHECKOUT_EARLY_TOLERANCE_MINUTES=15
# Opcional: empresa por defecto del bot cuando hay varias activas
BOT_DEFAULT_COMPANY_ID=
BOT_DEFAULT_COMPANY_NAME=Dinamic Systems

JWT_SECRET=
JWT_EXPIRES_IN=8h

# 2FA TOTP (AES-256-GCM key: 32 bytes as base64 or 64 hex chars). Do not reuse JWT_SECRET.
TWO_FACTOR_ISSUER=Dinamic Attendance
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_CHALLENGE_SECRET=
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
# Pending TOTP setup/reconfigure TTL (server is source of truth)
TWO_FACTOR_SETUP_TTL_MINUTES=10
# Rate limit in-memory (por instancia; en multi-instancia el tope no es global).
# Misma política para POST /auth/login/2fa, /auth/2fa/confirm, /auth/2fa/disable
# y /auth/2fa/recovery-codes/regenerate.
TWO_FACTOR_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
TWO_FACTOR_LOGIN_RATE_LIMIT_MAX=8

# Invitaciones de usuarios (tokens opacos; TTL en horas)
INVITATION_TTL_HOURS=72

# Recuperación de contraseña (tokens opacos hasheados; TTL en minutos)
PASSWORD_RESET_TTL_MINUTES=60
# Piso de duración de forgot-password (mitigación de timing, no constant-time)
PASSWORD_RESET_MIN_DURATION_MS=300
PASSWORD_RESET_DURATION_JITTER_MS=150
# Rate limit in-memory (por instancia; en multi-instancia el tope no es global)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Email: EMAIL_TRANSPORT=smtp|console|disabled
# console solo en development/test (no cuenta como enviado).
# En production usá smtp (SMTP_* completo) o disabled explícito.
EMAIL_TRANSPORT=console
# Gmail en 587: SMTP_SECURE=false (STARTTLS). Puerto 465: SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Test-only toggles (local/CI). Leave empty/false for normal unit runs.
RUN_DB_INTEGRATION_TESTS=
RUN_DB_PRIVILEGE_TESTS=

# Google Cloud Storage — adjuntos de ausencias (bucket privado)
# Dejá el JSON real en ../secrets/gcp-service-account.json (nunca lo commits).
# Ver secrets/README.md en la raíz del monorepo.
GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-service-account.json
# Optional ADC project hint used by GCS pilot scripts.
GCLOUD_PROJECT=
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_STORAGE_PREFIX=absence-attachments
GCS_SIGNED_URL_EXPIRATION_SECONDS=300
GCS_MAX_FILE_SIZE_BYTES=5242880
GCS_MAX_FILES_PER_REQUEST=5
GCS_MAX_TOTAL_SIZE_BYTES=15728640
GCS_UPLOAD_MODE=BACKEND_STREAM
# When true, GCS must be configured and reachable for platform diagnostics to be "ok".
GCS_REQUIRED=false
PLATFORM_SERVER_STATUS_CHECK_TIMEOUT_MS=3000
API_SERVICE_NAME=dinamic-attendance-api
ABSENCE_ATTACHMENT_CLEANUP_JOB_ENABLED=true
ABSENCE_ATTACHMENT_PENDING_TTL_MINUTES=60
# Recibos de sueldo (mismo bucket GCS; prefijo distinto)
PAYROLL_RECEIPTS_STORAGE_PREFIX=payroll-receipts
PAYROLL_RECEIPTS_MAX_FILES_PER_BATCH=50
PAYROLL_RECEIPT_NOTIFICATION_WORKER_ENABLED=true
PAYROLL_RECEIPT_NOTIFICATION_WORKER_INTERVAL_MS=60000
PAYROLL_RECEIPT_NOTIFICATION_LEASE_MS=120000
PAYROLL_RECEIPT_NOTIFICATION_MAX_ATTEMPTS=5
PAYROLL_RECEIPT_NOTIFICATION_RETRY_BASE_MS=30000
OPERATION_ASSIGNMENT_NOTIFICATION_WORKER_ENABLED=false
# Production: set TWILIO_EVENTUAL_OPERATION_ASSIGNED_CONTENT_SID first, then flip to true
# (startup fail-fast if worker=true without SID). Local/dev default stays false.
OPERATION_ASSIGNMENT_NOTIFICATION_WORKER_INTERVAL_MS=60000
OPERATION_ASSIGNMENT_NOTIFICATION_LEASE_MS=120000
OPERATION_ASSIGNMENT_NOTIFICATION_MAX_ATTEMPTS=5
OPERATION_ASSIGNMENT_NOTIFICATION_RETRY_BASE_MS=30000
PAYROLL_RECEIPT_MEDIA_URL_EXPIRATION_SECONDS=900
COMPANY_DELETION_GRACE_PERIOD_DAYS=30


COMPANY_DELETION_JOB_ENABLED=true
COMPANY_DELETION_JOB_INTERVAL_MS=3600000
# ONE_TIME clock promotions (SCHEDULED/IN_PROGRESS → COMPLETED). Startup + interval. No lookback window.
OPERATION_LIFECYCLE_JOB_ENABLED=true
OPERATION_LIFECYCLE_JOB_INTERVAL_MS=60000
OPERATION_LIFECYCLE_JOB_BATCH_SIZE=100
OPERATION_LIFECYCLE_JOB_MAX_BATCHES_PER_TICK=20
COMPANY_DELETION_LEASE_MS=1800000
COMPANY_DELETION_MAX_ATTEMPTS=10
COMPANY_DELETION_RETRY_BASE_MS=60000
# Prefer UUIDs (immutable). Names are legacy fallback only when IDs are empty.
COMPANY_PROTECTED_IDS=
COMPANY_PROTECTED_NAMES=Dinamic Systems

# Dev/test only: allow npm run seed:historical-operations (blocked in production).
ALLOW_SYNTHETIC_OPERATION_SEED=false

# Server-side Google Geocoding for location_zones (CLI / async geocode). Prefer this over VITE_*.
GOOGLE_MAPS_API_KEY=
