# Base URL of Dinamic Operations App (no trailing slash required).
# Local: VITE_OPERATIONS_APP_URL=http://localhost:8084 (puerto frontend en docker-compose / dev).
# Producción (post-separación de dominios): definir en GitHub Actions var VITE_OPERATIONS_APP_URL
#   https://app.dinamicoperations.com
# Si está vacío, el CTA Ingresar usa /login relativo (solo válido mientras app comparte el apex).
# VITE_OPERATIONS_APP_URL=http://localhost:8084
