# Dinamic Attendance — variables de entorno para Docker Compose
#
# Copiá este archivo a `.env` en la raíz del proyecto y completá los valores.
# El `.env` raíz es la fuente de verdad para `docker compose` en el servidor.
# No alcanza con cargar estas variables solo en `backend/.env`.
#
# Para desarrollo local:
#   docker compose --env-file .env up -d --build
#
# Para producción:
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# `backend/.env` sirve para ejecutar Node fuera de Docker.
# `frontend/.env` sirve para Vite local (`npm run dev`).
# En producción Docker, las variables VITE_* se inyectan durante el build del frontend.

NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

BACKEND_INTERNAL_PORT=3000
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173

FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

VITE_API_URL=http://localhost:3000/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Producción (deploy via GHCR): imagen pre-construida en GitHub Actions.
# Ejemplo: FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/frontend:develop-latest
# FRONTEND_IMAGE=

DB_HOST=sqlserver
DB_PORT=1433
DB_PORT_EXTERNAL=14330
DB_NAME=dinamic_attendance
DB_USER=sa
# Contraseña SA de SQL Server para Docker Compose (backend, migraciones y healthcheck).
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=
JWT_EXPIRES_IN=8h

INVITATION_TTL_HOURS=72
# EMAIL_TRANSPORT=smtp|console|disabled
# console only in development/test (never counts as delivered).
# production: use smtp (requires SMTP_*) or explicit disabled.
# EMAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_URL=
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_ARRIVAL_REMINDER_CONTENT_SID=
TWILIO_EXIT_REMINDER_CONTENT_SID=
TWILIO_TEMPLATE_NO_CHECKIN_SID=
TWILIO_ATTENDANCE_CONFIRMATION_CONTENT_SID=
ATTENDANCE_REMINDER_JOB_ENABLED=true
RECURRING_WORKDAY_HORIZON_DAYS=60
RECURRING_WORKDAY_MATERIALIZATION_JOB_ENABLED=true

BOT_SESSION_TTL_MINUTES=15
BOT_OPERATION_TIMEZONE=America/Argentina/Buenos_Aires
BOT_DEFAULT_RADIUS_METERS=150
BOT_GEOFENCE_REVIEW_MARGIN_METERS=30
BOT_ON_TIME_GRACE_MINUTES=15
BOT_CHECKOUT_EARLY_TOLERANCE_MINUTES=15
# Opcional: empresa por defecto del bot cuando hay varias activas
# BOT_DEFAULT_COMPANY_ID=
# BOT_DEFAULT_COMPANY_NAME=Dinamic Systems

# Google Cloud Storage — adjuntos de ausencias (bucket privado)
# Preferir ADC / Workload Identity en producción. No versionar JSON de service account.
# Docker: monta ./secrets → /app/secrets (ver secrets/README.md)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json
# Local (backend/): GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-service-account.json
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_STORAGE_PREFIX=absence-attachments
GCS_SIGNED_URL_EXPIRATION_SECONDS=300
GCS_MAX_FILE_SIZE_BYTES=5242880
GCS_MAX_FILES_PER_REQUEST=5
GCS_MAX_TOTAL_SIZE_BYTES=15728640
GCS_UPLOAD_MODE=BACKEND_STREAM
ABSENCE_ATTACHMENT_CLEANUP_JOB_ENABLED=true
ABSENCE_ATTACHMENT_PENDING_TTL_MINUTES=60
# Phase 5 operational integration is per-company (company_settings.absence_operational_integration_enabled).
# Enable with: npx tsx --import ./src/test-helpers/preload-test-env.ts src/scripts/enable-absence-operational-integration.ts --company=<uuid>
