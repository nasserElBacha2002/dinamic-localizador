# Node
node_modules/
npm-debug.log*

# Build outputs
dist/
build/

# Environment
.env
backend/.env
frontend/.env

# OS / IDE
.DS_Store
.vscode/
.idea/

# Local env backups / secrets
*.env.save
backend/.env.save

# Generated reconciliation artifacts
.cache/
reports/
backend/reports/

# Local git review artifacts (Cursor commands)
review/

# Audit generated artifacts (keep structure, ignore volatile run snapshots)
audit/raw/runs/
audit/raw/_meta/
audit/raw/partial/
audit/raw/*.txt
audit/raw/*.json
audit/raw/*.md
audit/audit-summary.md
audit/audit-status.json
audit/audit-diff.md
audit/audit-report.json
audit/audit-report.md
audit/findings.json
audit/findings.md
audit/findings.prev.json
audit/current-run.json
audit/baseline/audit-status.baseline.json
audit/baseline/findings.baseline.json
audit/audit-improvements-diff.txt
audit/audit-improvements-diffstat.txt
audit/audit-improvements-status.txt
audit/audit-framework-corrections-diff.txt
audit/audit-framework-corrections-diffstat.txt
audit/audit-framework-corrections-status.txt
audit/phase1-quality-gate-cleanup-diff.txt
audit/phase1-quality-gate-cleanup-diffstat.txt
audit/phase1-quality-gate-cleanup-status.txt
audit/phase2-sql-security-triage-diff.txt
audit/phase2-sql-security-triage-diffstat.txt
audit/phase2-sql-security-triage-status.txt
audit/phase3-concurrency-idempotency-diff.txt
audit/phase3-concurrency-idempotency-diffstat.txt
audit/phase3-concurrency-idempotency-status.txt
audit/implementation-corrections-diff.txt
audit/implementation-corrections-diffstat.txt
audit/implementation-corrections-status.txt
audit/latest-diff.txt
audit/latest-diffstat.txt
audit/latest-status.txt
*.zip

# Keep directory placeholders
!audit/raw/.gitkeep
!audit/raw/runs/.gitkeep
!audit/baseline/.gitkeep

# Google Cloud credentials (never commit)
*service-account*.json
*gcp-credentials*.json
google-credentials.json

# GCP secrets folder (dinamic-gemini pattern) — real keys only; keep docs/examples
secrets/*
!secrets/.gitkeep
!secrets/README.md
!secrets/*.example
# Negate after *service-account*.json so the example stays tracked
!secrets/gcp-service-account.json.example
backend/secrets/
!backend/secrets/.gitkeep
__pycache__/
*.py[cod]
