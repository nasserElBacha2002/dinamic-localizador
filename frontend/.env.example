# Variables para Vite en desarrollo local (npm run dev en frontend/).
# En producción Docker, VITE_* se pasan como build args en docker-compose.prod.yml.

VITE_API_URL=http://localhost:3000/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Observabilidad WhatsApp (platform admin). Omitir o true = habilitado; false = oculta nav y muestra acceso denegado.
VITE_WHATSAPP_OBSERVABILITY_UI_ENABLED=true
