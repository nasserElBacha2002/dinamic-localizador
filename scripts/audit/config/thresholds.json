{
  "god_class": {
    "loc_watch": 600,
    "loc_high": 1000,
    "methods_high": 20,
    "deps_high": 10,
    "imports_high": 8,
    "complex_methods_high": 8,
    "score_ok": 5,
    "score_watch": 9,
    "score_medium": 14,
    "score_high": 20
  },
  "complexity": {
    "file_loc_warn": 800,
    "file_loc_high": 1200,
    "control_flow_token_density_high": 80,
    "_notes": {
      "method_loc": "not implemented yet",
      "nesting": "not implemented yet",
      "control_flow_token_density": "heuristic token count (if/for/while/&&/||/??), not cyclomatic complexity"
    }
  },
  "architecture": {
    "forbidden_import_patterns": [
      {
        "from_glob": "**/controllers/**",
        "to_pattern": "database/connection",
        "rule": "controllers-must-not-import-db-connection",
        "severity": "high",
        "confidence": "medium",
        "status": "requires-review"
      },
      {
        "from_glob": "**/controllers/**",
        "to_pattern": "/database/",
        "rule": "controllers-must-not-import-database",
        "severity": "high",
        "confidence": "medium",
        "status": "requires-review",
        "except_to_contains": ["migration"]
      },
      {
        "from_glob": "**/repositories/**",
        "to_pattern": "/services/",
        "rule": "repositories-must-not-import-services",
        "severity": "high",
        "confidence": "medium",
        "status": "detected"
      },
      {
        "from_glob": "**/repositories/**",
        "to_pattern": "../services",
        "rule": "repositories-must-not-import-services-relative",
        "severity": "high",
        "confidence": "medium",
        "status": "detected"
      },
      {
        "from_glob": "backend/src/**",
        "to_pattern": "frontend",
        "rule": "backend-must-not-import-frontend",
        "severity": "critical",
        "confidence": "high",
        "status": "detected",
        "blocking": true,
        "match_mode": "case_insensitive_contains"
      }
    ]
  },
  "sql": {
    "risk_layers": ["controllers", "routes", "middleware"]
  },
  "gate": {
    "block_severities": ["critical"],
    "block_high_with_confidence": ["high"],
    "ignore_statuses": ["accepted-risk", "false-positive"]
  },
  "scan_roots": ["backend/src", "frontend/src"],
  "exclude_globs": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/build/**",
    "**/.git/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.integration.test.ts",
    "**/test-helpers/**"
  ],
  "scanner_coverage": {
    "framework": [
      "architecture",
      "god-classes",
      "complexity",
      "sql",
      "solid",
      "grasp",
      "patches",
      "exceptions",
      "reliability",
      "env-consistency"
    ],
    "legacy": [
      "npm audit",
      "secrets",
      "env documentation",
      "docker security",
      "security deep",
      "madge circular",
      "jscpd duplication",
      "ts-prune dead exports",
      "tenant isolation script",
      "backend/frontend lint/typecheck/test/build"
    ]
  }
}
