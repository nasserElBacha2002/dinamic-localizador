# HTTPS FINAL (STEP 6+) — NO instalar sin certificados válidos en disco.
# Usar primero deploy/nginx.bootstrap.dinamicoperations.com.conf.template (HTTP :80).
# Tras certbot, reemplazar por esta plantilla con rutas ssl_certificate reales.
#
# Puertos loopback: WEBSITE_HOST_PORT=8085, FRONTEND_HOST_PORT=8084
# server_name: ajustar www solo si existe DNS www (no es obligatorio).

server {
    listen 443 ssl http2;
    server_name dinamicoperations.com;

    ssl_certificate /etc/letsencrypt/live/dinamicoperations.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dinamicoperations.com/privkey.pem;

    location /api/ {
        return 404;
    }

    location ^~ /marketing-assets/ {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /assets/ {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /favicon.svg {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_set_header Host $host;
    }

    location = / {
        proxy_pass http://127.0.0.1:${WEBSITE_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:${FRONTEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Referrer-Policy "no-referrer" always;
    }
}

# Opcional — solo si DNS www está configurado (certificado debe incluir -d www...):
# server {
#     listen 443 ssl http2;
#     server_name www.dinamicoperations.com;
#     ssl_certificate /etc/letsencrypt/live/dinamicoperations.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/dinamicoperations.com/privkey.pem;
#     return 301 https://dinamicoperations.com$request_uri;
# }

server {
    listen 80;
    server_name dinamicoperations.com;
    return 301 https://dinamicoperations.com$request_uri;
}
