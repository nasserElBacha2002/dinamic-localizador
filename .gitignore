# Build outputs
dist/
build/

# Environment
.env
backend/.env
frontend/.env

# OS / IDE
.DS_Store
.vscode/
.idea/

# Local env backups / secrets
*.env.save
backend/.env.save

# Generated reconciliation artifacts
.cache/
reports/
backend/reports/

# Local git review artifacts (Cursor commands)
review/

# Root-generated implementation review dumps (never commit)
/implementation-*-diff.txt
/implementation-*-diffstat.txt
/implementation-*-status.txt
/implementation-*-validation.md
/latest-diff.txt
/latest-diffstat.txt
/latest-status.txt
/latest-validation.txt

# Audit generated artifacts (keep structure, ignore volatile run snapshots)
