# HTTPS FINAL (STEP 6+) — NO instalar sin certificados válidos.
# Bootstrap: deploy/nginx.bootstrap.api.dinamicoperations.com.conf.template

server {
    listen 443 ssl http2;
    server_name api.dinamicoperations.com;

    ssl_certificate /etc/letsencrypt/live/api.dinamicoperations.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.dinamicoperations.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:${BACKEND_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.dinamicoperations.com;
    return 301 https://$host$request_uri;
}
